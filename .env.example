# 必填：JWT 签名密钥（任意随机长字符串）
JWT_SECRET=change-me-to-a-long-random-string

# 必填：AES-256-GCM 加密密钥，必须是 base64 编码的 32 字节
# 生成：node -e "console.log(Buffer.from(crypto.getRandomValues(new Uint8Array(32))).toString('base64'))"
ENCRYPTION_KEY=

# 可选：首次部署时自动创建的管理员账号（不填则第一个注册的用户成为管理员）
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# 可选：覆盖 DNSHE API 基础地址
DNSHE_API_BASE=https://api005.dnshe.com/index.php?m=domain_hub

# 可选：定时任务令牌（EdgeOne schedules 调用 /api/cron 时校验）
CRON_TOKEN=

# 前端本地开发时指向 Worker 地址（生产同源可留空）
# NEXT_PUBLIC_API_BASE=http://localhost:8787

# 仅用于真实接口联调测试（tests/live.test.ts），不要提交真实值
# DNSHE_API_KEY=cfsd_xxx
# DNSHE_API_SECRET=yyy

