{
  "name": "dnshe-free-domain-manage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "dev:all": "concurrently -k -n api,web -c blue,green \"npm:cf:dev\" \"npm:dev\"",
    "build": "next build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf:dev": "wrangler dev --config cf-worker/wrangler.toml",
    "cf:deploy": "wrangler deploy --config cf-worker/wrangler.toml"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "lucide-react": "^0.468.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3",
    "wrangler": "^3.99.0"
  }
}
